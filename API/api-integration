mport hashlib
import os
import re
from datetime import datetime, timedelta, timezone

import requests
from dotenv import load_dotenv

# ------------------------------------
# 1. CONFIGURATION
# ------------------------------------
load_dotenv()

NEWS_API_KEY = os.getenv("NEWS_API_KEY")
if not NEWS_API_KEY:
    raise ValueError("Please add NEWS_API_KEY in your .env file")

NEWS_URL = "https://newsapi.org/v2/everything"

# Maps common city name variations so queries capture all local news
CITY_ALIASES = {
    "bengaluru": ["Bengaluru", "Bangalore"],
    "mumbai": ["Mumbai", "Bombay"],
    "delhi": ["Delhi", "New Delhi"],
    "chennai": ["Chennai", "Madras"],
    "kolkata": ["Kolkata", "Calcutta"]
}

# ------------------------------------
# 2. NEWS CATEGORIES
# ------------------------------------
NEWS_CATEGORIES = {
    "local_news": "({city_query})",
    "trending": "({city_query}) AND (breaking OR trending OR alert OR traffic OR civic)",
    "current_affairs": "({city_query}) AND (government OR policy OR civic OR election OR administration)",
    "business": "({city_query}) AND (business OR startup OR funding OR company OR economy)",
    "trading": '("stock market" OR trading OR NIFTY OR SENSEX OR stocks OR cryptocurrency OR investment)',
    "sports": "({city_query}) AND (sports OR cricket OR RCB OR ISL OR BFC OR stadium)",
    "technology": "({city_query}) AND (technology OR AI OR software OR IT OR tech)",
    "entertainment": "({city_query}) AND (entertainment OR cinema OR concert OR event OR festival)",
    "health": "({city_query}) AND (health OR hospital OR medical OR wellness)",
    "science": "({city_query}) AND (science OR ISRO OR IISc OR research OR space)"
}

# ------------------------------------
# 3. HELPER FORMATTING FUNCTIONS
# ------------------------------------
def build_city_query(city: str) -> str:
    """Build an OR query covering city aliases (e.g., 'Bengaluru OR Bangalore')."""
    aliases = CITY_ALIASES.get(city.lower().strip(), [city.strip()])
    return " OR ".join(f'"{alias}"' for alias in aliases)


def clean_text(text: str | None) -> str:
    """Remove HTML tags, extra whitespace, and NewsAPI truncation suffixes like '[+1234 chars]'."""
    if not text:
        return ""
    text = re.sub(r"<[^>]+>", "", text)
    text = re.sub(r"\[\+\d+\s+chars\]$", "", text)
    return " ".join(text.split()).strip()


def format_article(raw_article: dict, genre: str, city: str) -> dict | None:
    """Validate and normalize a raw NewsAPI article object into a clean schema."""
    title = clean_text(raw_article.get("title"))
    url = (raw_article.get("url") or "").strip()

    # Skip removed or malformed articles
    if not title or not url or title == "[Removed]":
        return None

    # Generate deterministic unique ID from URL for easy downstream deduplication
    article_id = hashlib.sha256(url.encode("utf-8")).hexdigest()[:16]

    return {
        "id": article_id,
        "city": city.lower().strip(),
        "genre": genre,
        "title": title,
        "description": clean_text(raw_article.get("description")),
        "content": clean_text(raw_article.get("content")),
        "source": ((raw_article.get("source") or {}).get("name") or "Unknown").strip(),
        "author": clean_text(raw_article.get("author")) or "Unknown",
        "url": url,
        "image_url": (raw_article.get("urlToImage") or "").strip(),
        "published_at": (raw_article.get("publishedAt") or "").strip()
    }

# ------------------------------------
# 4. MAIN API FETCH & FORMAT PIPELINE
# ------------------------------------
def fetch_formatted_news(
    genre: str,
    city: str = "Bengaluru",
    days_back: int = 3,
    page_size: int = 30
) -> list[dict]:
    """
    Fetch articles from NewsAPI for a specific genre and city,
    deduplicate them, and return a clean list of formatted dictionaries.
    """
    query_template = NEWS_CATEGORIES.get(genre)
    if not query_template:
        raise ValueError(f"Unsupported genre '{genre}'. Valid options: {list(NEWS_CATEGORIES.keys())}")

    city_query = build_city_query(city)
    search_query = query_template.format(city_query=city_query)
    from_date = (datetime.now(timezone.utc) - timedelta(days=days_back)).strftime("%Y-%m-%d")

    params = {
        "q": search_query,
        "language": "en",
        "from": from_date,
        "sortBy": "publishedAt",
        "pageSize": min(page_size, 100),
        "apiKey": NEWS_API_KEY
    }

    try:
        response = requests.get(NEWS_URL, params=params, timeout=15)
        response.raise_for_status()
        payload = response.json()

        if payload.get("status") != "ok":
            print(f"[NewsAPI Error] {payload.get('code')}: {payload.get('message')}")
            return []

        formatted_articles = []
        seen_ids = set()

        for raw_item in payload.get("articles", []):
            formatted = format_article(raw_item, genre=genre, city=city)
            if formatted and formatted["id"] not in seen_ids:
                seen_ids.add(formatted["id"])
                formatted_articles.append(formatted)

        return formatted_articles

    except requests.RequestException as err:
        print(f"[Network/HTTP Error] Failed to fetch '{genre}' news for '{city}': {err}")
        return []


# ------------------------------------
# 5. STANDALONE TEST RUNNER
# ------------------------------------
if _name_ == "_main_":
    import json

    sample_news = fetch_formatted_news(genre="local_news", city="Bengaluru", page_size=5)
    print(f"Fetched & formatted {len(sample_news)} articles:\n")
    print(json.dumps(sample_news, indent=2))
